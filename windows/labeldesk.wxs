<?xml version="1.0" encoding="utf-8"?>
<!-- LabelDesk for Windows — per-user MSI built on Fedora with wixl (tools/build-windows.sh). No admin rights needed.
     Files: %LOCALAPPDATA%\Programs\LabelDesk · Data (history, settings, log): %LOCALAPPDATA%\LabelDesk and
     %APPDATA%\LabelDesk — kept on uninstall. UpgradeCode is fixed forever: a newer MSI replaces an older one. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="LabelDesk" Version="@VERSION@" Manufacturer="LabelDesk" Language="1033"
           UpgradeCode="6B9C2E31-4A57-4D3F-9E1B-2F7C5A0D8E41">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Description="LabelDesk — DYMO label printing" Comments="Inventory tags and shipping labels on DYMO LabelWriters"/>
    <Property Id="ALLUSERS" Value="2"/>
    <Property Id="MSIINSTALLPERUSER" Value="1"/>
    <!-- Always copy every file. Without it an upgrade skips files whose version didn't change (python.exe…) as "already
         there", then removing the old version deletes them: LabelDesk installed without Python (seen 0.5.0/0.8.1 → 0.9.0
         on the test VM, 2026-10-10). -->
    <Property Id="REINSTALLMODE" Value="amus"/>
    <Media Id="1" Cabinet="labeldesk.cab" EmbedCab="yes"/>
    <Icon Id="LabelDeskIcon" SourceFile="$(var.Src)/icon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="LabelDeskIcon"/>

    <Upgrade Id="6B9C2E31-4A57-4D3F-9E1B-2F7C5A0D8E41">
      <UpgradeVersion Minimum="0.0.0" Maximum="@VERSION@" IncludeMaximum="no" Property="OLDER_FOUND"/>
      <UpgradeVersion Minimum="@VERSION@" IncludeMinimum="no" OnlyDetect="yes" Property="NEWER_FOUND"/>
    </Upgrade>
    <!-- Upgrades with LabelDesk running (it always is: Startup folder). Its server is a windowless pythonw, which Windows'
         "close these applications: Python" dialog can't close: the old server kept running, Python's files were only
         replaced at the next reboot and the PC showed the old version (2026-10-16, 0.5.0 → 0.9.1 on the test VM). So stop
         every process running from LabelDesk's own python folder before InstallValidate checks for files in use, and
         start the new server after the install. The command is -EncodedCommand (UTF-16LE base64) because MSI would
         read [ ] in PowerShell as properties; source: Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath
         -like '*\Programs\LabelDesk\python\python*.exe' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force
         -ErrorAction SilentlyContinue }; Start-Sleep -Milliseconds 700 -->
    <!-- wixl has no Directory= custom actions: set a property to the program, then run that property (types 51 + 50) -->
    <CustomAction Id="SetPowerShell" Property="LD_POWERSHELL" Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"/>
    <CustomAction Id="StopLabelDesk" Property="LD_POWERSHELL" Execute="immediate" Return="ignore"
                  ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand "/>
    <CustomAction Id="SetPythonw" Property="LD_PYTHONW" Value="[INSTALLDIR]python\pythonw.exe"/>
    <CustomAction Id="StartLabelDesk" Property="LD_PYTHONW" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[INSTALLDIR]labeldesk-server.pyw&quot;"/>
    <InstallExecuteSequence>
      <!-- explicit numbers: wixl's After= ordering put RemoveExistingProducts behind InstallFinalize once Custom rows were added
           (CostFinalize 1000 · InstallValidate 1400 · InstallFinalize 6600) -->
      <Custom Action="SetPowerShell" Sequence="1001"/>
      <Custom Action="StopLabelDesk" Sequence="1002"/>
      <RemoveExistingProducts Sequence="1401"/>
      <Custom Action="SetPythonw" Sequence="6601">NOT (REMOVE~="ALL")</Custom>
      <Custom Action="StartLabelDesk" Sequence="6602">NOT (REMOVE~="ALL")</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="LabelDesk"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
      <Directory Id="StartupFolder"/>
      <Directory Id="SystemFolder"/>
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3E0F2A61-9C4B-4E7A-8D21-5B6C7F9A0E12">
        <Shortcut Id="LabelDeskStart" Name="LabelDesk" Description="Print inventory tags and shipping labels"
                  Target="[INSTALLDIR]python\pythonw.exe" Arguments="&quot;[INSTALLDIR]LabelDesk.pyw&quot;"
                  WorkingDirectory="INSTALLDIR" Icon="LabelDeskIcon"/>
        <RegistryValue Root="HKCU" Key="Software\LabelDesk" Name="startmenu" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="8A4D1C73-2B5E-4F90-A6C3-1D7E9B2F4A58">
        <Shortcut Id="LabelDeskStartup" Name="LabelDesk (background)" Description="LabelDesk's print server"
                  Target="[INSTALLDIR]python\pythonw.exe" Arguments="&quot;[INSTALLDIR]labeldesk-server.pyw&quot;"
                  WorkingDirectory="INSTALLDIR" Icon="LabelDeskIcon"/>
        <RegistryValue Root="HKCU" Key="Software\LabelDesk" Name="startup" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="InstallDirKey" Guid="C5B7E2D9-6F14-4A83-B0E6-9D2A7C4F1B36">
        <RegistryValue Root="HKCU" Key="Software\LabelDesk" Name="installdir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="LabelDesk" Level="1">
      <ComponentGroupRef Id="AppFiles"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="StartupShortcut"/>
      <ComponentRef Id="InstallDirKey"/>
    </Feature>
  </Product>
</Wix>
